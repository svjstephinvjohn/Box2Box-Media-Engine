# ─── Application ─────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── AWS ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# AWS credentials are auto-resolved from ~/.aws/credentials or IAM role in Lambda
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB table names (set by CDK at deploy time) ─────────────
NEWS_ARTICLES_TABLE=football-news-articles
GENERATED_POSTS_TABLE=football-generated-posts
PUBLISHING_LOG_TABLE=football-publishing-log
TRENDS_TABLE=football-trends

# ─── S3 ───────────────────────────────────────────────────────────
IMAGES_BUCKET_NAME=your-images-bucket-name

# ─── Secrets Manager secret names ─────────────────────────────────
OPENAI_SECRET_NAME=football-app/openai
META_SECRET_NAME=football-app/meta
API_FOOTBALL_SECRET_NAME=football-app/api-football

# ─── OpenAI (used in local dev; Lambda reads from Secrets Manager) ─
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Meta / Instagram (local dev only) ───────────────────────────
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# ─── API-Football (RapidAPI) ──────────────────────────────────────
API_FOOTBALL_KEY=your-rapidapi-key
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# ─── Content pipeline ─────────────────────────────────────────────
DAILY_POST_LIMIT=5
APPROVAL_MODE=auto
# APPROVAL_MODE=approval_required   ← requires APPROVAL_SNS_TOPIC_ARN

# ─── RAG ──────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SCAN_LIMIT=200

# ─── DALL-E ───────────────────────────────────────────────────────
DALLE_IMAGE_SIZE=1024x1024

# ─── Media ───────────────────────────────────────────────────────
MEDIA_OUTPUT_DIR=media_output
MEDIA_BASE_URL=http://localhost:8000/media


# ─── Publishing limits ────────────────────────────────────────────────────────
DAILY_POST_LIMIT=5